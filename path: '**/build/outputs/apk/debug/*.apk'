      - name: Build debug APK
        run: |
          WRAPPER="$(find . -type f -name gradlew -not -path '*/.gradle/*' -print -quit)"
          if [ -z "$WRAPPER" ]; then
            echo "::error::No gradlew script found in the repository"
            exit 1
          fi
          chmod +x "$WRAPPER"
          cd "$(dirname "$WRAPPER")"
          ./gradlew assembleDebug --no-daemon
